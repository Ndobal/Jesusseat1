NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/jesusseat.sqlite
# Production requires HTTPS and all three mail values. No credentials belong in Git.
MAIL_API_KEY=
MAIL_FROM=
# 32+ random characters; encrypts queued messages AND enrolled authenticator secrets.
# Keep stable and back up securely. Losing it prevents authenticator verification.
# Required in production. Development uses a local key in data/, never committed.
OUTBOX_KEY=
# Optional inbox notification address. Messages remain in the inbox even without email alerts.
PLATFORM_NOTIFICATION_EMAIL=
# Optional operator-approved external checkout. Leave empty until donations are ready.
DONATION_CHECKOUT_URL=
DONATION_PROVIDER_LABEL=

# Optional media-account connections. Manual public video links work without these.
# Register exact /media/oauth/youtube/callback and /media/oauth/facebook/callback URLs.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Operator must verify a supported Graph API version and approved Page permissions.
FACEBOOK_GRAPH_VERSION=
