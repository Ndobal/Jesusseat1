NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/jesusseat.sqlite
# Production requires HTTPS and all three mail values. No credentials belong in Git.
MAIL_API_KEY=
MAIL_FROM=
# 32+ random characters; encrypts queued verification/recovery/invitation messages.
# Required in production. Development uses a local key in data/, never committed.
OUTBOX_KEY=
