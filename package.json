{
  "name": "jesusseat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/security.js && node --check public/app.js",
    "mail": "node --env-file-if-exists=.env scripts/mail.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  }
}
